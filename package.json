{
  "name": "christmas-chaos",
  "version": "1.0.0",
  "description": "Christmas family party game",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node --test --test-concurrency=1 --test-force-exit test/game.test.js test/e2e.test.js",
    "test:unit": "node --test --test-force-exit test/game.test.js",
    "test:e2e": "node --test --test-concurrency=1 --test-force-exit test/e2e.test.js",
    "test:ui": "node test/ui-smoke.mjs",
    "firewall": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-firewall.ps1"
  },
  "dependencies": {
    "@fontsource-variable/big-shoulders-display": "^5.3.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/lilita-one": "^5.3.0",
    "express": "^4.18.2",
    "qrcode": "^1.5.4",
    "socket.io": "^4.7.2"
  },
  "devDependencies": {
    "playwright-core": "^1.65.1",
    "socket.io-client": "^4.8.4"
  }
}
